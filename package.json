{
  "name": "stash_bot",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "npm run build && node ./build/index",
    "dev": "npx nodemon",
    "build": "rimraf ./build && npx tsc",
    "migrate": "dotenv -- node migrate up",
    "migrate:rollback": "dotenv -- node migrate down",
    "migration:create": "dotenv -- node migrate create"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^22.15.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "mysql2": "^3.14.2",
    "rimraf": "^6.0.1",
    "sequelize-typescript": "^2.1.6",
    "telegraf": "^4.16.3",
    "ts-node": "^10.9.2",
    "umzug": "^3.8.2",
    "winston": "^3.17.0"
  }
}
